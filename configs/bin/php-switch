#!/usr/bin/env bash
# ==============================================================================
# php-switch / sphp - Flexible PHP Version Switcher for OmarchyOS (Arch Linux)
# ==============================================================================
set -euo pipefail

BIN_DIR="${HOME}/.local/bin"
mkdir -p "$BIN_DIR"

# Colors
C_RESET="\033[0m"
C_BOLD="\033[1m"
C_GREEN="\033[38;5;82m"
C_BLUE="\033[38;5;39m"
C_YELLOW="\033[38;5;214m"
C_RED="\033[38;5;196m"
C_GRAY="\033[38;5;245m"

# Find current active version
get_current_version() {
    if command -v php &>/dev/null; then
        php -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;" 2>/dev/null || echo "unknown"
    else
        echo "none"
    fi
}

get_current_full_version() {
    if command -v php &>/dev/null; then
        php -v 2>/dev/null | head -n 1 || echo "unknown"
    else
        echo "none"
    fi
}

# Scan installed PHP versions
find_installed_versions() {
    local candidates=(
        "/usr/bin/php"
        "/usr/bin/php-legacy"
        /usr/bin/php8*
        /usr/bin/php7*
    )
    
    local seen_bins=()
    for bin in "${candidates[@]}"; do
        [ -x "$bin" ] || continue
        # Ignore symlinks in candidate scan if they point to ~/.local/bin or non-unique realpath
        local real
        real="$(readlink -f "$bin" 2>/dev/null || echo "$bin")"
        if [[ " ${seen_bins[*]} " =~ " ${real} " ]]; then
            continue
        fi
        seen_bins+=("$real")

        local ver
        ver=$("$bin" -r "echo PHP_MAJOR_VERSION.'.'.PHP_MINOR_VERSION;" 2>/dev/null || true)
        if [ -n "$ver" ]; then
            echo "$ver:$real"
        fi
    done | sort -Vu
}

get_companions() {
    local php_bin="$1"
    local fpm_bin=""
    local phpize_bin=""
    local config_bin=""
    local phar_bin=""

    if [[ "$php_bin" == *"-legacy" ]]; then
        [ -x "/usr/bin/php-fpm-legacy" ] && fpm_bin="/usr/bin/php-fpm-legacy"
        [ -x "/usr/bin/phpize-legacy" ] && phpize_bin="/usr/bin/phpize-legacy"
        [ -x "/usr/bin/php-config-legacy" ] && config_bin="/usr/bin/php-config-legacy"
        [ -x "/usr/bin/phar-legacy" ] && phar_bin="/usr/bin/phar-legacy"
    elif [[ "$php_bin" == "/usr/bin/php" ]]; then
        [ -x "/usr/bin/php-fpm" ] && fpm_bin="/usr/bin/php-fpm"
        [ -x "/usr/bin/phpize" ] && phpize_bin="/usr/bin/phpize"
        [ -x "/usr/bin/php-config" ] && config_bin="/usr/bin/php-config"
        [ -x "/usr/bin/phar" ] && phar_bin="/usr/bin/phar"
    else
        local base
        base="$(basename "$php_bin")"
        local suffix="${base#php}"
        [ -x "/usr/bin/php-fpm${suffix}" ] && fpm_bin="/usr/bin/php-fpm${suffix}"
        [ -x "/usr/bin/php-fpm-${suffix}" ] && fpm_bin="/usr/bin/php-fpm-${suffix}"
        [ -x "/usr/bin/phpize${suffix}" ] && phpize_bin="/usr/bin/phpize${suffix}"
        [ -x "/usr/bin/php-config${suffix}" ] && config_bin="/usr/bin/php-config${suffix}"
        [ -x "/usr/bin/phar${suffix}" ] && phar_bin="/usr/bin/phar${suffix}"
    fi

    echo "$fpm_bin|$phpize_bin|$config_bin|$phar_bin"
}

list_versions() {
    local current
    current="$(get_current_version)"
    local current_full
    current_full="$(get_current_full_version)"

    echo -e "${C_BOLD}PHP Version Switcher (php-switch / sphp)${C_RESET}"
    echo -e "${C_GRAY}Active PHP:${C_RESET} ${C_GREEN}${current_full}${C_RESET} (using $(command -v php 2>/dev/null || echo 'none'))"
    echo ""
    echo -e "${C_BOLD}Installed PHP versions:${C_RESET}"

    local found=0
    while IFS=":" read -r ver bin; do
        [ -n "$ver" ] || continue
        found=1
        local full_ver
        full_ver=$("$bin" -r "echo PHP_VERSION;" 2>/dev/null || echo "")
        if [ "$ver" == "$current" ]; then
            echo -e "  ${C_GREEN}* ${ver}${C_RESET} (${full_ver}) -> ${bin} ${C_BOLD}[active]${C_RESET}"
        else
            echo -e "    ${C_BLUE}${ver}${C_RESET} (${full_ver}) -> ${bin}"
        fi
    done < <(find_installed_versions)

    if [ "$found" -eq 0 ]; then
        echo -e "  ${C_RED}No PHP versions found in /usr/bin!${C_RESET}"
    fi

    echo ""
    echo -e "${C_GRAY}Usage:${C_RESET}"
    echo -e "  php-switch <version>    Switch to specified version (e.g. 8.5, 8.3)"
    echo -e "  sphp <version>          Short alias for php-switch"
    echo -e "  php-switch list         List all installed versions"
    echo -e "  php-switch reset        Reset to system default (8.5)"
}

switch_version() {
    local target="$1"
    local restart_fpm=0
    if [ "${2:-}" == "--fpm" ]; then
        restart_fpm=1
    fi

    # Handle keywords
    if [ "$target" == "default" ] || [ "$target" == "system" ] || [ "$target" == "reset" ]; then
        target="8.5"
    fi

    local target_bin=""
    local target_ver=""

    while IFS=":" read -r ver bin; do
        [ -n "$ver" ] || continue
        if [ "$ver" == "$target" ] || [ "${ver//./}" == "$target" ]; then
            target_bin="$bin"
            target_ver="$ver"
            break
        fi
    done < <(find_installed_versions)

    if [ -z "$target_bin" ]; then
        echo -e "${C_RED}[ERROR]${C_RESET} PHP version '${target}' is not installed!"
        echo ""
        list_versions
        exit 1
    fi

    local companions
    companions="$(get_companions "$target_bin")"
    IFS="|" read -r fpm_bin phpize_bin config_bin phar_bin <<< "$companions"

    echo -e "${C_BLUE}[INFO]${C_RESET} Switching PHP to version ${C_BOLD}${target_ver}${C_RESET}..."

    # Link php
    ln -sfn "$target_bin" "${BIN_DIR}/php"

    # Link companion binaries if available
    [ -n "$fpm_bin" ] && ln -sfn "$fpm_bin" "${BIN_DIR}/php-fpm"
    [ -n "$phpize_bin" ] && ln -sfn "$phpize_bin" "${BIN_DIR}/phpize"
    [ -n "$config_bin" ] && ln -sfn "$config_bin" "${BIN_DIR}/php-config"
    [ -n "$phar_bin" ] && ln -sfn "$phar_bin" "${BIN_DIR}/phar"
    [ -n "$phar_bin" ] && [ -f "${phar_bin}.phar" ] && ln -sfn "${phar_bin}.phar" "${BIN_DIR}/phar.phar"

    local new_full
    new_full="$("${BIN_DIR}/php" -v 2>/dev/null | head -n 1)"

    echo -e "${C_GREEN}[SUCCESS]${C_RESET} Switched to ${C_BOLD}${new_full}${C_RESET}!"
    echo -e "  ${C_GRAY}Binary:${C_RESET}   ${target_bin} -> ${BIN_DIR}/php"
    if [ -n "$fpm_bin" ]; then
        echo -e "  ${C_GRAY}PHP-FPM:${C_RESET}  ${fpm_bin} -> ${BIN_DIR}/php-fpm"
    fi
    if command -v composer &>/dev/null; then
        local comp_ver
        comp_ver="$(composer --version 2>/dev/null | head -n 1 || echo "")"
        echo -e "  ${C_GRAY}Composer:${C_RESET} ${comp_ver}"
    fi

    # Manage FPM service if requested
    if [ "$restart_fpm" -eq 1 ]; then
        echo -e "${C_BLUE}[INFO]${C_RESET} Restarting PHP-FPM service..."
        local svc_name="php-fpm"
        if [ "$target_ver" == "8.3" ]; then
            svc_name="php-fpm-legacy"
        fi
        if sudo systemctl restart "$svc_name"; then
            echo -e "${C_GREEN}[SUCCESS]${C_RESET} Restarted service ${svc_name}!"
        fi
    fi
}

case "${1:-}" in
    ""|"-l"|"--list"|"list"|"status")
        list_versions
        ;;
    "-h"|"--help"|"help")
        list_versions
        ;;
    *)
        switch_version "$1" "${2:-}"
        ;;
esac
