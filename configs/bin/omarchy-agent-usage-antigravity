#!/usr/bin/env python3
"""
Collect Antigravity usage and quota into one display-ready JSON record for Omarchy.

Reads real per-group quota via agy --print /usage --output-format json.
History counts are local activity, not a measurement of server quota.

Watches ~/.gemini/antigravity-cli history, conversations, and quota status.
Configurable via ~/.config/omarchy/agents/antigravity.json.
Writes to ~/.local/state/omarchy/agents/usage/antigravity.json.
"""

import os
import sys
import json
import sqlite3
import shutil
import subprocess
import math
import fcntl
from contextlib import closing
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
GEMINI_DIR = HOME / ".gemini" / "antigravity-cli"
HISTORY_FILE = GEMINI_DIR / "history.jsonl"
DB_FILE = GEMINI_DIR / "conversation_summaries.db"
LOG_DIR = GEMINI_DIR / "log"
CANDIDATE_LOG_DIRS = [
    GEMINI_DIR / "log",
    HOME / ".gemini" / "antigravity" / "log",
]

CONFIG_DIR = HOME / ".config" / "omarchy" / "agents"
CONFIG_FILE = CONFIG_DIR / "antigravity.json"

USAGE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "omarchy" / "agents" / "usage"
USAGE_FILE = USAGE_DIR / "antigravity.json"

# Default quota configuration for Antigravity
DEFAULT_CONFIG = {
    "tier_label": "DeepMind"
}

def load_config():
    config = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.is_file():
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                user_conf = json.load(f)
                if isinstance(user_conf, dict):
                    config.update(user_conf)
        except Exception:
            pass
    else:
        # Create default config file if it doesn't exist
        try:
            CONFIG_DIR.mkdir(parents=True, exist_ok=True)
            with open(CONFIG_FILE, "w", encoding="utf-8") as f:
                json.dump(config, f, indent=2)
        except Exception:
            pass
    return config

def get_user_email(candidate_dirs=None):
    if candidate_dirs is None:
        candidate_dirs = CANDIDATE_LOG_DIRS

    log_files = []
    for log_dir in candidate_dirs:
        if isinstance(log_dir, (str, Path)):
            log_dir = Path(log_dir)
            if log_dir.is_dir():
                cli_log = log_dir.parent / "cli.log"
                if cli_log.is_file():
                    try:
                        resolved = cli_log.resolve()
                        if resolved.is_file():
                            log_files.append(resolved)
                    except Exception:
                        pass
                log_files.extend(log_dir.glob("cli-*.log"))
                log_files.extend(log_dir.glob("*.log"))

    seen = set()
    unique_logs = []
    for p in log_files:
        try:
            pr = p.resolve()
            if pr not in seen and pr.is_file():
                seen.add(pr)
                unique_logs.append(pr)
        except Exception:
            continue

    # Sort files prioritizing newest filename (cli-YYYYMMDD_HHMMSS.log ensures chronological order)
    # and mtime as secondary sort
    unique_logs.sort(key=lambda p: (p.name, os.path.getmtime(p)), reverse=True)

    for log in unique_logs:
        try:
            with open(log, "r", encoding="utf-8", errors="ignore") as f:
                lines = f.readlines()
            # Read in reverse (bottom-up) to find the most recent auth event
            for line in reversed(lines):
                if "applyAuthResult:" in line and "email=" in line:
                    parts = line.split("email=")
                    if len(parts) > 1:
                        email = parts[1].split(",")[0].strip()
                        if email and "@" in email:
                            return email
        except Exception:
            continue

    # Fallback to git config user.email if available
    try:
        res = subprocess.run(["git", "config", "user.email"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip() and "@" in res.stdout.strip():
            return res.stdout.strip()
    except Exception:
        pass

    return ""

def unknown_limits():
    return [
        {"label": f"{group} · {window}", "title": f"{group} · {window}",
         "percent": -1, "resetsAt": "", "unknown": True}
        for group in ("Gemini", "Claude / GPT") for window in ("5h", "Weekly")
    ]


def parse_quota(payload):
    """CLI reports remaining fractions; Omarchy meters report fractions used."""
    command = payload.get("command", {})
    if payload.get("status") != "SUCCESS" or command.get("name") != "usage":
        raise ValueError("Not a successful usage response")
    groups = command.get("data", {}).get("groups", [])
    expected = {
        "gemini-5h": ("Gemini", "5h"),
        "gemini-weekly": ("Gemini", "Weekly"),
        "3p-5h": ("Claude / GPT", "5h"),
        "3p-weekly": ("Claude / GPT", "Weekly"),
    }
    buckets = {}
    for group in groups:
        for bucket in group.get("buckets", []):
            bucket_id = bucket.get("id")
            if bucket_id in expected:
                if bucket_id in buckets:
                    raise ValueError("Duplicate quota bucket")
                buckets[bucket_id] = bucket
    limits = []
    for bucket_id, (group, window) in expected.items():
        title = f"{group} · {window}"
        entry = {"label": title, "title": title, "percent": -1,
                 "resetsAt": "", "unknown": True}
        bucket = buckets.get(bucket_id, {})
        remaining = bucket.get("remaining_fraction")
        reset = bucket.get("reset_time")
        if (isinstance(remaining, (int, float)) and not isinstance(remaining, bool)
                and math.isfinite(remaining) and 0 <= remaining <= 1
                and isinstance(reset, str)):
            try:
                reset_dt = datetime.fromisoformat(reset.replace("Z", "+00:00"))
                if reset_dt.tzinfo is not None:
                    entry.update(percent=1.0 - remaining, resetsAt=reset, unknown=False)
            except ValueError:
                pass
        limits.append(entry)
    if all(entry["unknown"] for entry in limits):
        raise ValueError("No valid quota buckets")
    return limits


def fetch_quota():
    executable = shutil.which("agy")
    if not executable:
        candidate = HOME / ".local/bin/agy"
        if candidate.is_file() and os.access(candidate, os.X_OK):
            executable = str(candidate)
    if not executable:
        return unknown_limits(), "Quota unavailable", "Antigravity CLI (agy) not found."
    try:
        result = subprocess.run(
            [executable, "--print", "/usage", "--output-format", "json"],
            capture_output=True, text=True, timeout=45, check=True,
            cwd=HOME,
        )
        limits = parse_quota(json.loads(result.stdout))
    except (OSError, subprocess.SubprocessError, ValueError, TypeError, AttributeError):
        return unknown_limits(), "Quota unavailable", "Could not refresh quota. Check agy /usage and sign-in."
    if any(entry["unknown"] for entry in limits):
        return limits, "Some quotas unavailable", "Some quota buckets were missing or invalid."
    return limits, "", ""


def proto_varint(blob, offset):
    value = 0
    for shift in range(0, 70, 7):
        if offset >= len(blob):
            raise ValueError("Truncated protobuf")
        byte = blob[offset]
        offset += 1
        value |= (byte & 127) << shift
        if byte < 128:
            return value, offset
    raise ValueError("Invalid varint")


def proto_fields(blob):
    offset = 0
    while offset < len(blob):
        tag, offset = proto_varint(blob, offset)
        wire = tag & 7
        if tag >> 3 == 0:
            raise ValueError("Invalid protobuf field")
        if wire == 0:
            value, offset = proto_varint(blob, offset)
        else:
            if wire == 2:
                size, offset = proto_varint(blob, offset)
            elif wire in (1, 5):
                size = 8 if wire == 1 else 4
            else:
                raise ValueError("Unsupported protobuf wire type")
            if offset + size > len(blob):
                raise ValueError("Truncated protobuf field")
            value = blob[offset:offset + size]
            offset += size
        yield tag >> 3, value


def token_stats(conversation_dir, dates, today):
    # Field numbers verified against the descriptors embedded in agy:
    # CortexStepGeneratorMetadata -> ChatModelMetadata -> ModelUsageStats.
    # Read generation usage once; the same usage is also copied into steps.
    days = {day: 0 for day in dates}
    models, today_models, seen = {}, {}, set()
    skipped = 0
    for path in sorted(conversation_dir.glob("*.db")):
        try:
            with closing(sqlite3.connect(path.as_uri() + "?mode=ro", uri=True)) as conn:
                timestamps = {}
                for idx, blob in conn.execute("SELECT idx, metadata FROM steps"):
                    try:
                        meta = dict(proto_fields(blob or b""))
                        stamp = dict(proto_fields(meta.get(1, b""))).get(1)
                        if stamp:
                            timestamps[idx] = datetime.fromtimestamp(stamp, timezone.utc).astimezone().strftime("%Y-%m-%d")
                    except (ValueError, TypeError, OverflowError, OSError):
                        continue
                for idx, blob in conn.execute("SELECT idx, data FROM gen_metadata"):
                    try:
                        entries = list(proto_fields(blob or b""))
                        meta = dict(entries)
                        chat = dict(proto_fields(meta.get(1, b"")))
                        if 4 not in chat:
                            continue
                        usage = dict(proto_fields(chat[4]))
                        identity = usage.get(7) or usage.get(11) or (path.name, idx)
                        if identity in seen:
                            continue
                        indices = []
                        for field, value in entries:
                            if field == 2:
                                if isinstance(value, int):
                                    indices.append(value)
                                else:
                                    pos = 0
                                    while pos < len(value):
                                        step, pos = proto_varint(value, pos)
                                        indices.append(step)
                        day = next((timestamps[i] for i in indices if i in timestamps), None)
                        if day is None:
                            skipped += 1
                            continue
                        model = (chat.get(21) or chat.get(19) or chat.get(22) or b"").decode("utf-8")
                        if not model:
                            model = f"Unknown model ({usage.get(1, 'unknown')})"
                        counts = {name: usage.get(field, 0) for name, field in
                                  (("inputTokens", 2), ("outputTokens", 3), ("cacheWriteTokens", 4), ("cacheReadTokens", 5))}
                        if any(not isinstance(v, int) or v < 0 for v in counts.values()):
                            raise ValueError("Invalid token count")
                        # Output already includes thinking + response tokens.
                        counts["totalTokens"] = sum(counts.values())
                        if counts["totalTokens"] == 0:
                            continue
                        seen.add(identity)
                        bucket = models.setdefault(model, {key: 0 for key in counts})
                        for key, value in counts.items():
                            bucket[key] += value
                        if day in days:
                            days[day] += counts["totalTokens"]
                        if day == today:
                            today_models[model] = today_models.get(model, 0) + counts["totalTokens"]
                    except (ValueError, TypeError, AttributeError, UnicodeError):
                        skipped += 1
        except sqlite3.Error:
            skipped += 1
    return days, models, today_models, skipped


def main():
    config = load_config()
    tier_label = str(config.get("tier_label", "DeepMind"))

    now_local = datetime.now()
    today_str = now_local.strftime("%Y-%m-%d")
    recent_dates = [(now_local - timedelta(days=i)).strftime("%Y-%m-%d") for i in range(6, -1, -1)]
    recent_days = {d: 0 for d in recent_dates}
    active_dates = set()

    total_prompts = 0
    today_prompts = 0
    unique_sessions = set()
    today_sessions = set()

    gemini_prompts_today = 0
    claude_prompts_today = 0


    # Track current active model per conversation (default to gemini)
    conv_model = {}

    if HISTORY_FILE.is_file():
        with open(HISTORY_FILE, "r", encoding="utf-8", errors="ignore") as f:
            for line in f:
                if not line.strip():
                    continue
                try:
                    data = json.loads(line)
                    ts_ms = data.get("timestamp")
                    conv_id = data.get("conversationId", "")
                    entry_type = data.get("type", "")
                    display_text = str(data.get("display", ""))

                    # Detect /model changes
                    if entry_type == "slash_command" and "/model" in display_text:
                        if "claude" in display_text.lower():
                            conv_model[conv_id] = "claude"
                        elif "gemini" in display_text.lower():
                            conv_model[conv_id] = "gemini"

                    if ts_ms:
                        dt_utc = datetime.fromtimestamp(ts_ms / 1000, tz=timezone.utc)
                        dt_local = dt_utc.astimezone()
                        d_str = dt_local.strftime("%Y-%m-%d")
                        active_dates.add(d_str)

                        if d_str in recent_days:
                            recent_days[d_str] += 1
                        
                        is_today = (d_str == today_str)
                        if is_today:
                            today_prompts += 1
                            if conv_id:
                                today_sessions.add(conv_id)

                        model_type = conv_model.get(conv_id, "gemini")
                        if "claude" in display_text.lower() and ("claude" in model_type or entry_type != "slash_command" and "claude-sonnet" in display_text):
                            model_type = "claude"

                        if is_today:
                            if model_type == "claude":
                                claude_prompts_today += 1
                            else:
                                gemini_prompts_today += 1

                    if conv_id:
                        unique_sessions.add(conv_id)
                    total_prompts += 1
                except Exception:
                    continue

    token_days, model_usage, today_by_model, skipped = token_stats(
        GEMINI_DIR / "conversations", recent_dates, today_str
    )

    user_email = get_user_email()

    limits, quota_status, quota_help = fetch_quota()

    record = {
        "schemaVersion": 1,
        "id": "antigravity",
        "name": "Antigravity",
        "updatedAt": datetime.now(timezone.utc).isoformat(),
        "ready": True,
        "hasLocalStats": True,
        "todayPrompts": today_prompts,
        "todaySessions": max(1, len(today_sessions)),
        "todayTotalTokens": sum(today_by_model.values()),
        "todayTokensByModel": today_by_model,
        "recentDays": [{"date": d, "messageCount": token_days[d]} for d in recent_dates],
        "totalPrompts": total_prompts,
        "totalSessions": max(1, len(unique_sessions)),
        "activeDays": len(active_dates),
        "activeDates": sorted(list(active_dates)),
        "modelUsage": model_usage,
        "tokenStatsSource": "conversation-db",
        "tokenStatsSkipped": skipped,
        "limits": limits,
        "tierLabel": tier_label,
        "usageStatusText": quota_status,
        "quotaSource": "agy-usage" if any(not entry["unknown"] for entry in limits) else "unavailable",
        "email": user_email,
        "authHelpText": quota_help
    }

    output_json = json.dumps(record, separators=(",", ":"))

    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    tmp_file = USAGE_DIR / f".antigravity.{os.getpid()}.tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        f.write(output_json + "\n")
    tmp_file.replace(USAGE_FILE)

    if sys.stdout.isatty():
        print(json.dumps(record, indent=2))

if __name__ == "__main__":
    USAGE_DIR.mkdir(parents=True, exist_ok=True)
    # Timer and popup refresh may run concurrently; allow only one CLI fetch.
    with (USAGE_DIR / ".antigravity.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            sys.exit(0)
        main()
